GOOGLE_SERVICE_ACCOUNT_FILE=/workspace/secrets/google-service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RAW_SHEET=raw_posts
GOOGLE_SHEETS_CLASSIFIED_SHEET=classified_topics
GOOGLE_SHEETS_IDEAS_SHEET=weekly_ideas


